      "stale_expected_tests": [
        "cargo test --test retired_closure"
      ],
      "follow_up_debt": [
        "shrd"
      ],
      "hard_gate_rule": "closure controls can reorder equal-risk candidates but must not add file/symbol/test/config risk reasons"
    },
    "operator_replay": {
      "refresh_status_rule": "status must replay the refresh projection counts without mutating graph.db",
      "doctor_rule": "doctor must be read-only and emit no repair commands when SQLite graph.db is current",
      "stale_convex_repair_rule": "stale Convex snapshot drift/doctor must fail closed and point operators to convex-sync repair commands before Convex-backed reads"
    }
  },
  "required_trace_links": [
    "backlog -> worker_result",
    "job_packet -> worker_result",
    "backlog/job_packet -> source_handle",
    "dispatch_trace.evidence_packet_ids -> conflict_matrix.orchestration.evidence_packet_ids",
    "dispatch_trace.replay_commands -> conflict_matrix.next_commands",
    "dependency_dag.topo_batches -> scheduler antichains",
    "dispatch_trace.repair_commands -> graph-db refresh/doctor"
  ],
