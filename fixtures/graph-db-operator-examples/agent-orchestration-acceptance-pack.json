    "scheduler_fields": {
      "parallel_safe": "per packet/candidate boolean; false when serial block edges or fail-closed ownership are present",
      "blocks": "target ids that must run after this packet because of unsafe overlap or worker-result follow-up debt",
      "blocked_by": "target ids that must complete before this packet joins a topological antichain",
      "required_context": "structured source_handle, worker_context, semantic, read-only file, and expansion-command handles",
      "graph_handles": "stable target node, evidence packet, worker prompt packet, projection, source-handle, worker-context, and semantic-handle ids"
    },
    "worker_feedback": {
