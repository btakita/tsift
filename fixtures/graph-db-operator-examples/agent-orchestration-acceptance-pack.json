{
  "name": "agent-orchestration-acceptance-pack",
  "version": "agent-orchestration-acceptance-pack-v1",
  "purpose": "Golden agent-doc orchestration rows and commands for validating graph-backed dispatch handoffs.",
  "command_sequence": [
    "tsift graph-db --path . refresh --json",
    "tsift graph-db --path . status --json",
    "tsift graph-db --path . doctor --json",
    "tsift graph-db --path . evidence wfdb --depth 3 --limit 8 --json",
    "tsift conflict-matrix --path tasks/software/tsift.md wfdb wfok --json",
    "tsift dependency-dag --path tasks/software/tsift.md wfdb shrd wfok --json",
    "tsift dispatch-trace --path tasks/software/tsift.md wfdb wfok --json",
    "tsift dispatch-trace --path tasks/software/tsift.md wfdb --format html",
    "tsift graph-db --path . --backend convex-snapshot --convex-snapshot fixtures/graph-db-operator-examples/stale-convex-snapshot.json drift --json",
    "tsift graph-db --path . --backend convex-snapshot --convex-snapshot fixtures/graph-db-operator-examples/stale-convex-snapshot.json doctor --json",
    "tsift convex-sync . --snapshot fixtures/graph-db-operator-examples/stale-convex-snapshot.json --chunk-size 25 --json",
    "tsift --envelope context-pack tasks/software/tsift.md --budget normal --json",
    "tsift session-review tasks/software/tsift.md --next-context --budget normal --json"
  ],
  "sample_session_markdown": {
    "path": "tasks/software/tsift.md",
    "queue": [
      "dispatch #spec-test-build-install-commit-push",
      "- do [#gval]",
      "- do [#shrd]",
      "  - do [#solo]",
      "- do [#wfdb]",
      "- do [#wfok]"
    ],
    "backlog": [
      "- [ ] [#gval] Verify helper bridge graph-db conformance.",
      "- [ ] [#shrd] Adjust shared helper ownership in main module.",
      "- [ ] [#solo] Update independent worker fixture in isolated module.",
      "- [ ] [#wfdb] Refresh closure worker feedback debt in closure module.",
      "- [ ] [#wfok] Update clean worker result fixture in clean module."
    ],
    "exchange": [
      "Completed `#gval`; touched files `main.rs`; tests `cargo test --test graph_db_conformance`; follow-up `#solo`.",
      "Completed `#solo`; touched files `isolated.rs`; tests `cargo test --test graph_db_conformance`; follow-up `#gval`.",
      "Blocked `#shrd`; touched files `main.rs`; tests `cargo test --test graph_db_conformance`; follow-up `#gval`.",
      "Blocked `#shrd`; touched files `main.rs`; tests `cargo test --test graph_db_conformance`; follow-up `#solo`.",
      "Blocked `#wfdb`; touched files `closure.rs`; tests `cargo test --test retired_closure`; follow-up `#shrd`.",
      "Completed `#wfok`; touched files `clean.rs`."
    ]
  },
  "sample_rows": {
    "job_packets": [
      {
        "kind": "job_packet",
        "properties": {
          "ref_id": "wfdb",
          "path": "tasks/software/tsift.md",
          "label": "do #wfdb"
        }
      },
      {
        "kind": "job_packet",
        "properties": {
          "ref_id": "wfok",
          "path": "tasks/software/tsift.md",
          "label": "do #wfok"
        }
      }
    ],
    "worker_results": [
      {
        "kind": "worker_result",
        "properties": {
          "ref_id": "wfdb",
          "status": "blocked",
          "touched_files": "closure.rs",
          "expected_tests": "cargo test --test retired_closure",
          "follow_up_ids": "shrd"
        }
      },
      {
        "kind": "worker_result",
        "properties": {
          "ref_id": "wfok",
          "status": "completed",
          "touched_files": "clean.rs"
        }
      }
    ]
  },
